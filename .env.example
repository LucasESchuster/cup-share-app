# Backend API root (required)
API_BASE_URL=http://localhost/api/v1

# Frontend origin (used for auth callbacks)
APP_URL=http://localhost:3000

# Controls secure cookies in production
NODE_ENV=development

# CloudFlare Turnstile (https://dash.cloudflare.com → Turnstile)
# Apenas a SITE KEY mora no frontend; a SECRET KEY fica no backend Laravel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Para testes locais use a test key do Cloudflare:
#   1x00000000000000000000AA  (always passes)
